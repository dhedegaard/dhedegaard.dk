{
  "name": "dhedegaard.dk",
  "version": "1.0.0",
  "description": "dhedegaard.dk",
  "homepage": "https://www.dhedegaard.dk/",
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": "24"
  },
  "scripts": {
    "start": "next start",
    "dev": "next dev",
    "build": "{ test -f src/graphql-env.d.ts || pnpm codegen; } && concurrently -c auto -n 'build,lint' 'next build' 'pnpm -s lint'",
    "test": "vitest run",
    "lint": "eslint src",
    "knip": "knip",
    "postinstall": "if [ -n \"$GITHUB_PAT\" ] && [ ! -f src/graphql-env.d.ts ]; then pnpm codegen; fi",
    "codegen": "gql.tada generate-schema 'https://api.github.com/graphql' --header \"Authorization: Bearer ${GITHUB_PAT}\" --header \"User-Agent: codegen\" --output ./github-schema.graphql && gql.tada generate-output"
  },
  "author": "Dennis Hedegaard <dennis@dhedegaard.dk>",
  "private": true,
  "license": "UNLICENSED",
  "dependencies": {
    "@sentry/nextjs": "^10.69.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "graphql": "^17.0.2",
    "lucide-react": "^1.28.0",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@tsconfig/next": "^2.0.6",
    "@tsconfig/strictest": "^2.0.8",
    "@types/node": "^26.1.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "babel-plugin-react-compiler": "^1.0.0",
    "concurrently": "^10.0.4",
    "eslint": "10.8.0",
    "eslint-config-next": "16.3.0",
    "eslint-config-prettier": "^10.1.8",
    "gql.tada": "^1.11.3",
    "knip": "^6.31.0",
    "postcss": "^8.5.25",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "8.65.0",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3"
  }
}
