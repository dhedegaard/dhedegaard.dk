{
  "name": "dhedegaard.dk",
  "version": "1.0.0",
  "description": "dhedegaard.dk",
  "homepage": "https://www.dhedegaard.dk/",
  "type": "module",
  "packageManager": "pnpm@11.5.2",
  "engines": {
    "node": "24"
  },
  "scripts": {
    "start": "next start",
    "dev": "next dev",
    "build": "concurrently -c auto -n 'build,list' 'next build' 'pnpm -s lint'",
    "test": "vitest run",
    "lint": "eslint src",
    "codegen": "graphql-codegen --config codegen.yml && prettier --write src/codegen/types.ts"
  },
  "author": "Dennis Hedegaard <dennis@dhedegaard.dk>",
  "private": true,
  "license": "UNLICENSED",
  "dependencies": {
    "@sentry/nextjs": "^10.56.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "lucide-react": "^1.17.0",
    "next": "16.2.7",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^7.1.2",
    "@graphql-codegen/typescript": "^6.0.2",
    "@graphql-typed-document-node/core": "^3.2.0",
    "@tailwindcss/postcss": "^4.3.0",
    "@tsconfig/next": "^2.0.6",
    "@tsconfig/strictest": "^2.0.8",
    "@types/node": "^25.9.2",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "babel-plugin-react-compiler": "^1.0.0",
    "concurrently": "^10.0.3",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.2.7",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-compiler": "19.1.0-rc.2",
    "graphql": "^16.14.1",
    "postcss": "^8.5.15",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.1",
    "vitest": "^4.1.8"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "19.2.17",
      "@types/react-dom": "19.2.3"
    }
  }
}
