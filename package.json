{
  "name": "dhedegaard.dk",
  "version": "1.0.0",
  "description": "dhedegaard.dk",
  "homepage": "https://www.dhedegaard.dk/",
  "type": "module",
  "engines": {
    "node": "24"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": ">=11",
      "onFail": "error"
    }
  },
  "scripts": {
    "start": "next start",
    "dev": "next dev",
    "build": "{ test -f src/graphql-env.d.ts || npm run -s codegen; } && concurrently -c auto -n 'build,lint' 'next build' 'npm run -s lint'",
    "test": "vitest run",
    "lint": "eslint src",
    "knip": "knip",
    "postinstall": "if [ -n \"$GITHUB_PAT\" ] && [ ! -f src/graphql-env.d.ts ]; then npm run codegen; fi",
    "codegen": "gql.tada generate-schema 'https://api.github.com/graphql' --header \"Authorization: Bearer ${GITHUB_PAT}\" --header \"User-Agent: codegen\" --output ./github-schema.graphql && gql.tada generate-output"
  },
  "author": "Dennis Hedegaard <dennis@dhedegaard.dk>",
  "private": true,
  "license": "UNLICENSED",
  "dependencies": {
    "@sentry/nextjs": "^10.75.3",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "graphql": "^16.14.2",
    "lucide-react": "^1.48.0",
    "next": "16.3.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@tsconfig/next": "^2.0.6",
    "@tsconfig/strictest": "^2.0.8",
    "@types/node": "^26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "concurrently": "^10.0.5",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.6",
    "eslint-config-prettier": "^10.1.8",
    "gql.tada": "^1.11.3",
    "knip": "^6.38.0",
    "postcss": "^8.5.28",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "8.70.1",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  },
  "allowScripts": {
    "@sentry/cli@2.58.6": true,
    "unrs-resolver@1.12.2": true,
    "fsevents@2.3.3": true
  },
  "overrides": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0"
  }
}
