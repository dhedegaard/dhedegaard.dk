{
  "name": "dhedegaard.dk",
  "version": "1.0.0",
  "description": "dhedegaard.dk",
  "homepage": "https://www.dhedegaard.dk/",
  "type": "module",
  "packageManager": "pnpm@11.8.0",
  "engines": {
    "node": "24"
  },
  "scripts": {
    "start": "next start",
    "dev": "next dev",
    "build": "{ test -f src/graphql-env.d.ts || pnpm codegen; } && concurrently -c auto -n 'build,lint' 'next build' 'pnpm -s lint'",
    "test": "vitest run",
    "lint": "eslint src",
    "postinstall": "if [ -n \"$GITHUB_PAT\" ] && [ ! -f src/graphql-env.d.ts ]; then pnpm codegen; fi",
    "codegen": "gql.tada generate-schema 'https://api.github.com/graphql' --header \"Authorization: Bearer ${GITHUB_PAT}\" --header \"User-Agent: codegen\" --output ./github-schema.graphql && gql.tada generate-output"
  },
  "author": "Dennis Hedegaard <dennis@dhedegaard.dk>",
  "private": true,
  "license": "UNLICENSED",
  "dependencies": {
    "@sentry/nextjs": "^10.61.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "graphql": "^16.14.2",
    "lucide-react": "^1.21.0",
    "next": "16.2.9",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.1",
    "@tsconfig/next": "^2.0.6",
    "@tsconfig/strictest": "^2.0.8",
    "@types/node": "^25.9.4",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "babel-plugin-react-compiler": "^1.0.0",
    "concurrently": "^10.0.3",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.2.9",
    "eslint-config-prettier": "^10.1.8",
    "gql.tada": "^1.11.2",
    "postcss": "^8.5.15",
    "prettier": "^3.8.4",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "tailwindcss": "^4.3.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "8.61.1",
    "vite": "^8.1.0",
    "vitest": "^4.1.9"
  }
}
